.documents-page {
  min-height: 100vh;

  background: #f8fafc;
}

.documents-header {
  padding: 28px 32px;

  background: white;

  border-bottom: 1px solid #e5e7eb;
}

.documents-header h1 {
  margin: 0;

  font-size: 24px;

  color: #111827;
}

.documents-header p {
  margin: 7px 0 0;

  font-size: 14px;

  color: #6b7280;
}

.documents-content {
  max-width: 1000px;

  margin: 0 auto;

  padding: 32px;
}

.upload-box {
  min-height: 220px;

  display: flex;

  flex-direction: column;

  align-items: center;

  justify-content: center;

  text-align: center;

  border: 2px dashed #d1d5db;

  border-radius: 14px;

  background: white;

  cursor: pointer;

  transition: 0.2s;
}

.upload-box:hover {
  border-color: #6b7280;

  background: #fafafa;
}

.upload-icon {
  width: 56px;
  height: 56px;

  display: flex;

  align-items: center;
  justify-content: center;

  margin-bottom: 14px;

  border-radius: 12px;

  background: #f3f4f6;

  color: #374151;
}

.upload-box h3 {
  margin: 0;

  font-size: 16px;

  color: #111827;
}

.upload-box p {
  margin: 7px 0;

  font-size: 13px;

  color: #6b7280;
}

.upload-box span {
  font-size: 12px;

  color: #9ca3af;
}

.documents-section {
  margin-top: 32px;
}

.documents-section-header {
  display: flex;

  align-items: center;

  justify-content: space-between;

  margin-bottom: 16px;
}

.documents-section-header h2 {
  margin: 0;

  font-size: 17px;

  color: #111827;
}

.documents-section-header span {
  font-size: 12px;

  color: #6b7280;
}

.document-list {
  display: flex;

  flex-direction: column;

  gap: 10px;
}

.document-card {
  min-height: 72px;

  display: flex;

  align-items: center;

  gap: 14px;

  padding: 14px 16px;

  border: 1px solid #e5e7eb;

  border-radius: 10px;

  background: white;
}

.document-icon {
  width: 40px;
  height: 40px;

  display: flex;

  align-items: center;
  justify-content: center;

  flex-shrink: 0;

  border-radius: 8px;

  background: #f3f4f6;

  color: #374151;
}

.document-info {
  flex: 1;

  min-width: 0;
}

.document-info h3 {
  margin: 0;

  overflow: hidden;

  text-overflow: ellipsis;

  white-space: nowrap;

  font-size: 14px;

  color: #111827;
}

.document-info p {
  margin: 4px 0 0;

  font-size: 11px;

  color: #9ca3af;
}

.document-status {
  display: flex;

  align-items: center;

  gap: 5px;

  font-size: 12px;

  color: #6b7280;
}

.document-delete {
  width: 34px;
  height: 34px;

  display: flex;

  align-items: center;
  justify-content: center;

  border: none;

  border-radius: 7px;

  background: transparent;

  color: #9ca3af;
}

.document-delete:hover {
  background: #f3f4f6;

  color: #374151;
}

.document-empty-state {
  padding: 60px 20px;

  display: flex;

  flex-direction: column;

  align-items: center;

  text-align: center;

  border: 1px solid #e5e7eb;

  border-radius: 12px;

  background: white;
}

.document-empty-icon {
  width: 52px;
  height: 52px;

  display: flex;

  align-items: center;
  justify-content: center;

  margin-bottom: 14px;

  border-radius: 10px;

  background: #f3f4f6;

  color: #6b7280;
}

.document-empty-state h2 {
  margin: 0;

  font-size: 17px;

  color: #111827;
}

.document-empty-state p {
  max-width: 400px;

  margin: 8px 0 0;

  font-size: 13px;

  line-height: 1.5;

  color: #6b7280;
}

.document-spinner {
  animation: document-spin 1s linear infinite;
}

@keyframes document-spin {

  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }

}

@media (max-width: 768px) {

  .documents-header {
    padding: 20px;
  }

  .documents-content {
    padding: 20px 16px;
  }

  .document-card {
    gap: 10px;
  }

  .document-status span {
    display: none;
  }

}